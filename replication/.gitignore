# The results of the paper are tracked at the paths where run_all.sh writes
# them (cap_and_share/output/, cap_and_share/paper/figures/, the PDFs in
# cap_and_share/paper/), as in the development repository: a new run
# overwrites them, and `git diff` / compare_to_reference.sh show what changed.
# Ignored: logs, LaTeX build files and the intermediate files of the solves.
logs/
cap_and_share/paper/build/
cap_and_share/output/cache/
cap_and_share/output/equal_pc/cache/
cap_and_share/output/*_checkpoint*.csv
cap_and_share/output/equal_pc/*_checkpoint*.csv
budget_ndc_CHN/
# Julia: the pinned environment is Manifest-v1.12.toml
Manifest.toml
# OS / editors
.DS_Store
.Rhistory
.RData
